        ],
        [
            "BRN0003",
            "SM City Davao",
            (
                "Second Floor, SM City Davao, Quimpo Blvd "
                "cor. Tulip and Ecoland Drive, "
                "Ecoland Subd., Matina, Davao City"
            ),
            "Davao City",
            "Mindanao",
        ],
    ],
    columns=[
        "branch_id",
        "branch_name",
        "address",
        "city",
        "island_group",
    ],
)

new_branches["brand_id"] = "BFC006"
