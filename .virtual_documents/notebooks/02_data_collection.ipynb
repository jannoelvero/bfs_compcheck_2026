        errors="raise",
    )

    next_number = (
        int(attempt_numbers.max()) + 1
        if not attempt_numbers.empty
        else 1
    )

    evidence_reference = evidence_folder.relative_to(
        project_root
    ).as_posix()

    new_attempt = pd.DataFrame(
        [{
            "attempt_id": f"ATT{next_number:04d}",
