    if match.sum() != 1:
        raise ValueError(
            f"Expected one record for {update['branch_id']}. "
            "Nothing saved."
        )

    actual_brand = branches.loc[match, "brand_id"].iloc[0]

    if actual_brand != update["brand_id"]:
        raise ValueError(
