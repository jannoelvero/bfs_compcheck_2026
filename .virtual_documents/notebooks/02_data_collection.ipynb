        inspection = {
            "sample_id": "SMP0070",
            "branch_id": "BRN0024",
            "captured_at": capture_time.isoformat(),
            "final_url": page.url,
            "newest_clicked": newest_clicked,
            "review_order_verified": False,
            "inspection_note": inspection_note,
            "reviews_imported": 0,
        }

        (capture_folder / "inspection.json").write_text(
            json.dumps(
                inspection,
                indent=2,
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

