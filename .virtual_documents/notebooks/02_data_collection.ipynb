    branch_directory.loc[
        branch_directory["branch_id"].isin(
            ["BRN0001", "BRN0002", "BRN0003"]
        ),
        [
            "branch_id",
            "brand_id",
            "branch_name",
            "city",
            "island_group",
            "operating_status",
            "verification_status",
        ],
    ]
)





