    "2026/09/2026-CBTL-Menu.pdf"
)

response = requests.get(pdf_url, timeout=45)
response.raise_for_status()

if not response.content.startswith(b"%PDF"):
    raise ValueError("The response is not a PDF. Nothing saved.")

